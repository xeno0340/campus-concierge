# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus-concierge
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
CLIENT_URL=http://localhost:5173

# --- Seeding the first admin (npm run seed:admin) ---
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Production only ---
# NODE_ENV=production
# TRUST_PROXY_HOPS=2
# CORS_EXTRA_ORIGINS=https://another-site.example

# --- Payments (Razorpay test mode keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email: choose one ---
# Local development with Gmail (needs a Google app password):
EMAIL_USER=
EMAIL_PASS=
# Production with Brevo (HTTPS API, works on free hosting):
# BREVO_API_KEY=
# EMAIL_FROM=

# --- Optional ---
# PORT=5000
# JWT_EXPIRES_IN=7d
# CAMPUS_TZ_OFFSET_MIN=330